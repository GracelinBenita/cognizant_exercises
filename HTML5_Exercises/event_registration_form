```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Registration Form</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        form {
            width: 400px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        label {
            font-weight: bold;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            margin-bottom: 15px;
        }

        button {
            padding: 10px 20px;
        }

        output {
            display: block;
            margin-top: 15px;
            color: green;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <h1>Community Event Registration</h1>

    <form onsubmit="showMessage(); return false;">

        <label for="name">Name:</label>
        <input type="text"
               id="name"
               placeholder="Enter your full name"
               required
               autofocus>

        <label for="email">Email:</label>
        <input type="email"
               id="email"
               placeholder="Enter your email address"
               required>

        <label for="date">Event Date:</label>
        <input type="date"
               id="date"
               required>

        <label for="eventType">Event Type:</label>
        <select id="eventType" required>
            <option value="">Select an Event</option>
            <option>Cultural Festival</option>
            <option>Sports Meet</option>
            <option>Health Camp</option>
            <option>Tree Plantation Drive</option>
        </select>

        <label for="message">Message:</label>
        <textarea id="message"
                  rows="4"
                  placeholder="Enter additional details"></textarea>

        <button type="submit">Register</button>

        <output id="confirmation"></output>

    </form>

    <script>
        function showMessage() {
            document.getElementById("confirmation").value =
                "Registration submitted successfully!";
        }
    </script>

</body>

</html>
```
